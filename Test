    while S.alive do
        if S.emoteCycle and #EmoteNames > 0 then
            S.selectedEmote = EmoteNames[math.random(1, #EmoteNames)]
            playSelectedEmote(S.selectedEmote)
            task.wait(math.max(tonumber(S.emoteCycleDelay) or 2, 0.5))
        else
            task.wait(0.2)
        end
    end
end)
