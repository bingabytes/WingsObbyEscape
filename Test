--============================================================
 -- DYNAMIC NUMBER PARSER
 --============================================================
 local function parseNumber(value)
 if value == nil then
 return nil
 end
local text = tostring(value)  

text = text  
    :gsub(",", "")  
    :gsub("%s+", "")  

local number, suffix =  
    text:match(  
        "([%d%.]+)([KkMmBbTt]?)"  
    )  

if not number then  
    return nil  
end  

local n = tonumber(number)  

if not n then  
    return nil  
end  

suffix = (suffix or ""):upper()  

if suffix == "K" then  
    n *= 1e3  
elseif suffix == "M" then  
    n *= 1e6  
elseif suffix == "B" then  
    n *= 1e9  
elseif suffix == "T" then  
    n *= 1e12  
end  

return math.floor(n)

end
