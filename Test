 local function fmt(n)
 n = math.floor(tonumber(n) or 0)
if n >= 1e12 then  
    return ("%.2fT"):format(n / 1e12)  
elseif n >= 1e9 then  
    return ("%.2fB"):format(n / 1e9)  
elseif n >= 1e6 then  
    return ("%.2fM"):format(n / 1e6)  
elseif n >= 1e3 then  
    return ("%.2fK"):format(n / 1e3)  
end  

return tostring(n)

end
