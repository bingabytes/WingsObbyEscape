local function uiTextBlob(object)
    if not object then return "" end
    local pieces = {}
    local current = object
    for _ = 1, 4 do
        if not current then break end
        pieces[#pieces + 1] = tostring(current.Name or ""):lower()
        if current:IsA("TextLabel") or current:IsA("TextButton") or current:IsA("TextBox") then
            pieces[#pieces + 1] = tostring(current.Text or ""):lower()
        end
        current = current.Parent
    end
    return table.concat(pieces, " ")
end

